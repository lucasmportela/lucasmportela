# Desenvolvimento local: o sistema gera uma chave HMAC persistente em instance/audit_hmac.key.
APP_ENV=development

# Em produção, configure estas chaves fora do repositório.
# SECRET_KEY=gere-uma-chave-aleatoria-de-pelo-menos-32-caracteres
# AUDIT_HMAC_KEY=gere-outra-chave-aleatoria-de-pelo-menos-32-caracteres

# PostgreSQL opcional; sem DATABASE_URL, o sistema usa instance/sentinela.db.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sentinela
