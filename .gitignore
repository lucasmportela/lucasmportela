# =========================================================
# .gitignore — Portfólio lucasmportela
# Python, Node.js, React, Java, C/C++, C# e Web
# =========================================================

# -------------------------
# Sistema operacional
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -------------------------
# Editores e IDEs
# -------------------------
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.iml

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# -------------------------
# Segredos e configurações
# -------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
secrets/
credentials/
*.pem
*.key

# -------------------------
# Logs e arquivos temporários
# -------------------------
*.log
logs/
log/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.Python

.venv/
venv/
env/
ENV/
.conda/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/

.coverage
.coverage.*
htmlcov/

*.egg
*.egg-info/
.eggs/
wheels/

# -------------------------
# Node.js / JavaScript / TypeScript
# -------------------------
node_modules/
.npm/
.pnpm-store/

.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log

*.tsbuildinfo

# -------------------------
# Front-end e ferramentas de build
# -------------------------
dist/
build/
coverage/
.vite/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.angular/
.turbo/
.cache/
storybook-static/

# -------------------------
# Java / Maven / Gradle
# -------------------------
.gradle/
target/
out/
*.class
hs_err_pid*
replay_pid*

# -------------------------
# C / C++ / CMake
# -------------------------
cmake-build-*/
CMakeFiles/
CMakeCache.txt
compile_commands.json
Testing/

*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.pch
*.gch
*.gcda
*.gcno

# -------------------------
# C# / .NET
# -------------------------
[Bb]in/
[Oo]bj/
TestResults/
artifacts/
*.cache

# -------------------------
# Bancos de dados locais
# -------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# -------------------------
# Relatórios e testes
# -------------------------
reports/
test-results/
junit.xml
coverage.xml

# -------------------------
# Arquivos compactados
# -------------------------
*.zip
*.7z
*.rar

# -------------------------
# Pastas temporárias
# -------------------------
tmp/
temp/