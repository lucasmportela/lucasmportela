# Chave usada para assinar as sessões. Gere uma chave aleatória para cada ambiente.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENV=development

# Opcional: PostgreSQL. Se omitido, a aplicação usa SQLite em instance/auth.db.
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sistema_autenticacao

# Opcional: caminho alternativo para o arquivo SQLite (compatibilidade).
# AUTH_DATABASE=instance/auth.db
